pkgname=music_rust
pkgver=3.3.0
pkgrel=1
pkgdesc='Cross-platform MIDI and numbered-notation piano player'
arch=('x86_64')
url='https://github.com/FuturePioneer-3/music_rust'
license=('GPL-3.0-or-later')
depends=('ffmpeg' 'alsa-lib' 'fluidsynth' 'zstd' 'zlib' 'bzip2' 'xz' 'lz4' 'python')
options=('!debug')
source=('music')
sha256sums=('SKIP')

package() {
    install -Dm755 "$srcdir/music" "$pkgdir/usr/bin/music"
    install -Dm755 "$startdir/../convert/convert.py" "$pkgdir/usr/bin/music-convert"
    install -Dm644 "$startdir/../electronic_synth.sf2" \
        "$pkgdir/usr/share/music_rust/soundfonts/electronic_synth.sf2"
    install -Dm644 "$startdir/../README.md" "$pkgdir/usr/share/doc/music_rust/README.md"
    install -Dm644 "$startdir/../LICENSE" "$pkgdir/usr/share/licenses/music_rust/LICENSE"
}
